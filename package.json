{
  "name": "issue-bridge",
  "version": "0.2.0",
  "description": "Migrate issues between trackers (GitHub → Jira) with a reviewable plan, an idempotency ledger and a markdown report",
  "keywords": [
    "issue-migration",
    "github",
    "jira",
    "jira-cloud",
    "migration",
    "cli",
    "hexagonal-architecture"
  ],
  "license": "MIT",
  "author": "Matteo Ludovino",
  "homepage": "https://github.com/matteoludovino/issue-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteoludovino/issue-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/matteoludovino/issue-bridge/issues"
  },
  "type": "module",
  "bin": {
    "issue-bridge": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
